# Normalize text files and preserve Unix line endings for scripts and source.
* text=auto

*.sh text eol=lf
*.py text eol=lf
*.c text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.conf text eol=lf
*.service text eol=lf
*.target text eol=lf
