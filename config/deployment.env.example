# Host terminal configuration example: source this after adapting to the Orin deployment.
# It does NOT automatically configure systemd, Docker, device-tree, or container mounts.
# Use only with a vetted, isolated staging deployment; do not run on the existing recording setup.

export STACK="${HOME}/shared_dir/lidar_camera_recording_stack"
export BASE_STACK="${STACK}/time_sync_stack_v6_core.sh"
export TSC_TRIGGER="${HOME}/fsync_tools/tsc_trigger"
export TSC_DEVICE="/dev/cdi_tsc"
export CONTAINER="elated_satoshi"
export WS="${HOME}/forza_ws/race_stack"
export DATA_ROOT="${HOME}/shared_dir/offline_projection_runs"
export PTP_TARGET="lidar-time-sync.target"

# Camera intrinsic YAMLs and finalizer calibration bundle are accessed inside
# the container and may need container-side environment configuration.
